# Copy to server/.env. Keys are server-only and never sent to the browser.
HOST=127.0.0.1
PORT=3080
SGZ_MODEL_BASE_URL=https://api.deepseek.com/v1
SGZ_MODEL_NAME=deepseek-flash
SGZ_MODEL_API_KEY=
# Local development allows the current same-origin Host; Vite preserves its Host.
# Behind HTTPS set these to your real public origin and true.
# SGZ_PUBLIC_ORIGIN=https://agent.example.com
SGZ_COOKIE_SECURE=false
SGZ_MAX_RUNS=4
# Defaults to repository .state/server; keep this persistent across releases.
# SGZ_DATA_DIR=/var/lib/sgz-agent/data
# SGZ_PYTHON_PATH=/opt/sgz-agent/.venv/bin/python
