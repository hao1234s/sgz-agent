# Included by nginx.conf inside its http {} block.
log_format sgz_agent '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 80;
    server_name @DOMAIN@;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 308 https://@DOMAIN@$request_uri; }
}
server {
    listen 443 ssl;
    server_name @DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /var/www/sgz-agent/current/web;
    index index.html;
    access_log /var/log/nginx/sgz-agent.access.log sgz_agent;
    client_max_body_size 128k;
    location = /healthz { proxy_pass http://127.0.0.1:3080/health; }
    location /api/ {
        proxy_pass http://127.0.0.1:3080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_flags ~ secure;
        proxy_read_timeout 240s;
        proxy_send_timeout 240s;
        proxy_buffering off;
        proxy_cache off;
        proxy_next_upstream off;
    }
    location /dsh { return 404; }
    location /agent-api/ { return 404; }
    location ~ /\. { deny all; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location / { add_header Cache-Control "no-cache"; try_files $uri $uri/ /index.html; }
}
