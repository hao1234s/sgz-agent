# Copy to agent/deploy/.env.local. This file contains examples only.
SITE_DOMAIN=agent.example.com
SSH_USER=root
SSH_PORT=22
# SSH_HOST and SSH_PASSWORD may stay in the existing root .env (IP/password lines).
# For key authentication instead of a password:
# SSH_KEY_FILE=C:/Users/you/.ssh/id_ed25519
# SSH_KNOWN_HOSTS=C:/Users/you/.ssh/known_hosts

# Optional when /etc/sgz-agent/dsh.env already exists on the server.
# This model key is uploaded separately over SSH, never included in the release.
DEEPSEEK_API_KEY=
