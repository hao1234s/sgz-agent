[Unit]
Description=SGZ multi-user application with server-managed DSH headless
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sgz-agent
Group=sgz-agent
WorkingDirectory=/var/www/sgz-agent/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=SGZ_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
Environment=PORT=3080
Environment=SGZ_DATA_DIR=/var/lib/sgz-agent/data
Environment=SGZ_PUBLIC_ORIGIN=https://@DOMAIN@
Environment=SGZ_COOKIE_SECURE=true
EnvironmentFile=/etc/sgz-agent/dsh.env
ExecStart=/usr/bin/node /var/www/sgz-agent/current/server/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
